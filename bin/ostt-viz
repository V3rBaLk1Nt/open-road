#!/home/YOUR_USERNAME/.local/opencode-assist/bin/python
import fcntl, math, os, select, shlex, signal, struct, subprocess, sys, termios, time, tty
import numpy as np

# The popup is launched from a Hyprland keybind, which often has no LANG set.
# Without this the block-drawing characters render as mojibake.
for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

RATE = 16000
FFT = 2048
MIN_HZ = 80.0
MAX_HZ = 3000.0

SOURCE = os.environ.get("OSTT_VIZ_SOURCE", "default")
CAPTURE = os.environ.get("OSTT_VIZ_CAPTURE")
NOPASTE = os.environ.get("OSTT_VIZ_NOPASTE") == "1"
DEBUG = os.environ.get("OSTT_VIZ_DEBUG") == "1"
WAV = "/tmp/ostt-viz-%d.wav" % os.getpid()
PIDFILE = os.path.expanduser("~/.config/ostt-viz.pid")

GLYPHS = "0123456789ABCDEFabcxyz+-*/:.="
GREEN = (57, 255, 20)
YELLOW = (255, 183, 3)
RED = (255, 42, 42)
RAIN_DIM = (16, 78, 30)
RAIN_MID = (28, 130, 44)

state = {"stop": False, "cancel": False, "paused": False}


def on_signal(sig, frame):
    state["stop"] = True


for s in (signal.SIGUSR1, signal.SIGTERM, signal.SIGINT):
    signal.signal(s, on_signal)

win = np.hanning(FFT).astype(np.float32)


def term_size():
    buf = struct.pack("HHHH", 0, 0, 0, 0)
    fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, buf)
    rows, cols, _, _ = struct.unpack("HHHH", buf)
    return max(rows, 8), max(cols, 40)


def analyze(samples, nbands):
    x = samples.astype(np.float32) / 32768.0
    if x.size < FFT:
        x = np.pad(x, (0, FFT - x.size))
    else:
        x = x[-FFT:]
    spec = np.abs(np.fft.rfft(x * win))
    peak = max(float(spec.max()), 1e-9)
    shape = np.clip(
        (20.0 * np.log10(np.maximum(spec / peak, 1e-6)) + 78.0) / 78.0,
        0.0, 1.0)
    freqs = np.fft.rfftfreq(FFT, 1.0 / RATE)
    edges = np.linspace(MIN_HZ, MAX_HZ, nbands + 1)
    rms = float(np.sqrt(np.mean(x * x))) if x.size else 0.0
    db = 20.0 * math.log10(max(rms, 1e-6))
    drive = max(0.18, min(1.0, (db + 48.0) / 48.0))
    out = np.zeros(nbands)
    for i in range(nbands):
        m = (freqs >= edges[i]) & (freqs < edges[i + 1])
        if m.any():
            out[i] = float(shape[m].max()) * 100.0 * drive
    return out


def level_of(samples):
    x = samples.astype(np.float32) / 32768.0
    if x.size == 0:
        return 0.0
    rms = float(np.sqrt(np.mean(x * x)))
    db = 20.0 * math.log10(max(rms, 1e-6))
    return max(0.0, min(100.0, ((db + 60.0) / 60.0) * 100.0))


def render(vals, rows, cols, elapsed, lvl, tick, paused):
    parts = []
    head = "  UCO 777  " + ("* REC" if not paused else "|| PAUSED")
    head += "  %05.1fs  LVL:%03d%%  80-3000 Hz" % (elapsed, int(lvl))
    parts.append("\x1b[1;1H\x1b[2K\x1b[38;2;57;255;20m%s\x1b[0m" % head[:cols])

    mid = (rows + 2) // 2
    maxh = max(2, (rows - 4) // 2)
    trail = max(3, rows // 3)
    span = rows + trail

    for r in range(2, rows):
        d = abs(r - mid)
        line = ["\x1b[%d;1H" % r]
        cur = None
        for c in range(cols):
            ch = " "
            col = None
            v = vals[c] if c < len(vals) else 0.0
            h = int(v / 100.0 * maxh + 0.5)
            if h > 0 and d <= h:
                frac = d / float(maxh)
                col = GREEN if frac < 0.45 else (YELLOW if frac < 0.70 else RED)
                ch = "\u2588"
            else:
                lead = (tick // 2 + c * 7) % span
                dd = (lead - r) % span
                if dd < trail:
                    idx = (r * 131 + c * 17 + tick // 4) % len(GLYPHS)
                    ch = GLYPHS[idx]
                    if dd == 0:
                        col = RED
                    elif dd < 3:
                        col = RAIN_MID
                    else:
                        col = RAIN_DIM
            if col != cur:
                line.append("\x1b[0m" if col is None else "\x1b[38;2;%d;%d;%dm" % col)
                cur = col
            line.append(ch)
        line.append("\x1b[0m\x1b[K")
        parts.append("".join(line))

    foot = "  [ENTER] transcribe  [SPACE] pause  [ESC] cancel"
    parts.append("\x1b[%d;1H\x1b[2K\x1b[38;2;70;90;80m%s\x1b[0m" % (rows, foot[:cols]))
    parts.append("\x1b[?25l")
    sys.stdout.write("".join(parts))


def main():
    try:
        pid = int(open(PIDFILE).read().strip())
        os.kill(pid, 0)
        os.kill(pid, signal.SIGUSR1)
        return
    except Exception:
        pass
    try:
        open(PIDFILE, "w").write(str(os.getpid()))
    except Exception:
        pass

    proc = None
    if CAPTURE:
        fh = open(CAPTURE, "rb")
    else:
        proc = subprocess.Popen(
            ["pw-record", "--format=s16", "--rate=%d" % RATE, "--channels=1",
             "--target", SOURCE, WAV], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(60):
            if os.path.exists(WAV) and os.path.getsize(WAV) > 44:
                break
            time.sleep(0.05)
        fh = open(WAV, "rb")
        fh.seek(44)

    sys.stdout.write("\x1b[?1049h\x1b[2J")
    stdin_fd = sys.stdin.fileno()
    old = termios.tcgetattr(stdin_fd)
    tty.setcbreak(stdin_fd)
    start = time.time()
    buf = b""
    smooth = None
    lvl = 0.0
    tick = 0
    last = 0.0
    try:
        while not state["stop"]:
            chunk = fh.read(8192)
            if chunk:
                buf += chunk
                if len(buf) > 16384:
                    buf = buf[-4096:]
            while select.select([stdin_fd], [], [], 0)[0]:
                ch = os.read(stdin_fd, 1)
                if ch in (b"\r", b"\n"):
                    state["stop"] = True
                elif ch == b" ":
                    state["paused"] = not state["paused"]
                elif ch in (b"\x1b", b"q", b"Q", b"\x03"):
                    state["stop"] = True
                    state["cancel"] = True
            if state["stop"]:
                break
            now = time.time()
            if now - last < 0.045:
                time.sleep(0.004)
                continue
            last = now
            rows, cols = term_size()
            arr = np.frombuffer(buf[-4096:] if len(buf) >= 4096 else buf, dtype=np.int16)
            if arr.size >= 256:
                raw = analyze(arr, cols)
                if smooth is None or len(smooth) != cols:
                    smooth = raw.copy()
                else:
                    smooth = np.where(raw >= smooth, raw, np.maximum(smooth * 0.9, raw))
                lvl = level_of(arr)
            elif smooth is None:
                smooth = np.zeros(cols)
            tick += 1
            render(smooth, rows, cols, now - start, lvl, tick, state["paused"])
            if DEBUG:
                sys.stderr.write("bands=%d lvl=%.1f\n" % (len(smooth), lvl))
                sys.stderr.flush()
            sys.stdout.flush()
    finally:
        termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        if proc:
            proc.send_signal(signal.SIGINT)
            try:
                proc.wait(timeout=5)
            except Exception:
                proc.kill()
        fh.close()
        try:
            os.remove(PIDFILE)
        except Exception:
            pass

    if state["cancel"]:
        print("cancelled")
        return

    for _ in range(80):
        if os.path.exists(WAV) and os.path.getsize(WAV) > 2000:
            break
        time.sleep(0.1)
    ready = "/tmp/ostt-viz-ready-%d.wav" % os.getpid()
    try:
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", WAV,
                        "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", ready],
                       timeout=60, check=True)
    except Exception:
        ready = WAV
    text = ""
    try:
        text = subprocess.run(["ostt", "transcribe", ready], capture_output=True,
                              text=True, timeout=300).stdout.strip()
    except Exception:
        text = ""
    try:
        os.remove(ready)
    except Exception:
        pass
    if not text:
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        print("  heard nothing - no speech above the noise floor")
        print("  (clipboard left untouched)")
        time.sleep(3.0)
        try:
            os.remove(WAV)
        except Exception:
            pass
        return

    if not NOPASTE:
        try:
            subprocess.run(["wl-copy"], input=text, text=True, timeout=10)
        except Exception:
            pass
        # Hand focus back to the window the user was typing in, once this
        # popup is actually gone, then drop a flag so the Hyprland config can
        # paste. Keystroke injection is impossible from out here (no
        # virtual-keyboard protocol), so the config does the paste.
        flag = "/tmp/ostt-viz-paste-flag"
        poll = ("for i in $(seq 1 80); do "
                "n=$(hyprctl -j clients 2>/dev/null | python3 -c "
                "\"import json,sys;print(len([x for x in json.load(sys.stdin) "
                "if x.get('class')=='ostt-popup']))\" 2>/dev/null); "
                "[ \"$n\" = \"0\" ] && break; sleep 0.25; done; "
                "hyprctl eval 'hl.dispatch(hl.dsp.focus({last=true}))' >/dev/null 2>&1; "
                "sleep 0.4; printf ok > " + flag)
        subprocess.Popen(["/bin/bash", "-c", poll], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    sys.stdout.write("\x1b[?25h\x1b[?1049l")
    sys.stdout.flush()
    print("  " + text)
    print("")
    print("  transcribing done - pasting automatically")
    sys.stdout.flush()
    time.sleep(2.5)
    try:
        os.remove(WAV)
    except Exception:
        pass


main()
